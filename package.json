{
  "name": "youtube-clone-frontend",
  "private": true,
  "scripts": {
    "dev": "npx http-server -c-1 -p 5173",
    "start": "npm run dev",
    "lint:js": "eslint . --ext .js --max-warnings=0 || true",
    "lint:css": "stylelint \"styles/**/*.css\" --allow-empty-input || true",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check:lh": "npx @lhci/cli autorun --upload",
    "ci": "npm run lint && npm test"
  },
  "devDependencies": {
    "@lhci/cli": "^0.8.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/dom": "^8.20.2",
    "eslint": "^8.50.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.6.1",
    "prettier": "^2.8.8",
    "stylelint": "^14.22.0",
    "stylelint-config-standard": "^27.0.0"
  }
}
